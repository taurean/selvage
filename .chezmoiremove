# Targets of files removed from source. chezmoi doesn't delete a target when its
# source file goes away, and ~/.zshrc sources every ~/.zshrc.d/*.zsh, so a stale
# tmux.zsh would keep loading. Drop these entries once every machine has applied
# past 0.2.0.
.zshrc.d/tmux.zsh
.config/tmux/tmux.conf

# Ghostty replaced WezTerm in 1.1.0 and WezTerm's config left source in 1.1.1.
# Drop this entry once every machine has applied past 1.1.1.
.config/wezterm/wezterm.lua

# Ghostty also loads this macOS app-support config after ~/.config/ghostty, and
# a stray theme line there overrode the Flexoki pair. All Ghostty settings live
# in dot_config/ghostty/config.tmpl. Drop this entry once every machine has
# applied past the release that adds it.
Library/Application Support/com.mitchellh.ghostty/config

# Unmanaged usgc themes the app-support config pointed at. Flexoki is the only
# Ghostty theme pair. Same drop condition as the entry above.
.config/ghostty/themes/usgc-polyimide
.config/ghostty/themes/usgc-highk
.config/ghostty/themes/usgc-reticle-it
