# Secrets pulled from 1Password, fetched lazily so opening a shell never blocks on
# a 1Password prompt. A shell that only runs a script (e.g. a launcher's
# .command file) would otherwise wait on the prompt before running it.
#
# NPM_TOKEN loads on the first npm, npx or pnpm call in a shell (~/.npmrc reads it).
# Everything else: run `load-secrets`. Values live in that shell's env only, so
# each new shell fetches again on first use.
_load_secret() {
  local var=$1 ref=$2
  [[ -n "${(P)var}" ]] && return                 # already in env
  local val; val=$(op read "$ref" --account {{ .onePasswordAccount | quote }} 2>/dev/null)
  [[ -z "$val" ]] && return                       # fetch failed/cancelled — don't export empties
  export "$var=$val"
}

_load_npm_token() {
  _load_secret NPM_TOKEN "op://Private/npm registry token/token"
}

load-secrets() {
  _load_npm_token
  _load_secret BRAVE_API_KEY    "op://Private/Brave Search API/password"
  _load_secret DEEPGRAM_API_KEY "op://Private/Deepgram API key/password"
}

npm()  { _load_npm_token; command npm "$@"; }
npx()  { _load_npm_token; command npx "$@"; }
pnpm() { _load_npm_token; command pnpm "$@"; }
