# Secrets pulled from 1Password. tmux spawns each pane from the *server*, not as a
# child of a sibling shell, so a runtime `export` never reaches other panes — the
# old guard re-ran `op` (and re-prompted 1Password) in every new pane. Fix: on the
# first fetch, cache the value in the tmux *server* environment so later panes
# inherit it. Result: one `op` call per tmux server instead of one per pane.
#
# A cached value persists until the server restarts; after rotating a token run
# `tmux set-environment -gu NPM_TOKEN` (or `tmux kill-server`) to drop the stale copy.
_load_secret() {
  local var=$1 ref=$2
  [[ -n "${(P)var}" ]] && return                 # already in env (incl. tmux global env)
  local val; val=$(op read "$ref" --account {{ .onePasswordAccount | quote }} 2>/dev/null)
  [[ -z "$val" ]] && return                       # fetch failed/cancelled — don't cache empties
  export "$var=$val"
  [[ -n "$TMUX" ]] && tmux set-environment -g "$var" "$val"   # share with future panes
}

_load_secret NPM_TOKEN       "op://Private/npm registry token/token"
_load_secret BRAVE_API_KEY   "op://Private/Brave Search API/password"
_load_secret DEEPGRAM_API_KEY "op://Private/Deepgram API key/password"
unset -f _load_secret
