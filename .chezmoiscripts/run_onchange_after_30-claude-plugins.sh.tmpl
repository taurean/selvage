#!/bin/bash
# Registers the suede-home marketplace and installs the suede-process plugin at
# user scope. An after_ script, so ~/.claude/settings.json (which declares the
# marketplace and enables the plugin) is written before this runs. Re-runs only
# when this script's text changes. It deliberately doesn't hash settings.json:
# every settings edit would re-run it, and each run reorders the target (below).
#
# Safe to run twice: add and install report "already" and exit 0. The update
# calls pull the marketplace's main and move the plugin to its newest commit
# (the plugin has no version field, so it tracks commits).
#
# `marketplace add` rewrites ~/.claude/settings.json in its own key order. The
# content matches the source, so the next `chezmoi apply` restores the order;
# `chezmoi diff` shows the reorder until then.
set -euo pipefail

claude="$HOME/.local/bin/claude"
if [[ ! -x "$claude" ]]; then
  echo "selvage: claude not found at $claude. Install Claude Code with its native installer (https://code.claude.com/docs), then apply again." >&2
  exit 1
fi

cd "$HOME"
"$claude" plugin marketplace add taurean/suede-home
"$claude" plugin install suede-process@suede-home --scope user
"$claude" plugin marketplace update suede-home
"$claude" plugin update suede-process@suede-home
