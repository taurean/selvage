# Selvage Brewfile — reference only on the live machine.
# Install packages manually one at a time; `brew bundle install` is for VM dry-runs only.

# Terminal & shell
cask "wezterm"
brew "tmux"

# Editor
brew "neovim"
brew "tree-sitter-cli"

# Search & navigation
brew "ripgrep"
brew "fd"

# Git
brew "git-lfs"

# 1Password CLI
brew "op"

# Language managers
brew "pyenv"
brew "rbenv"

# Note: Pi (AI coding assistant) is installed via pnpm, not brew:
