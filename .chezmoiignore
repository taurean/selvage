# Repo docs. Patterns match target paths, and `*` does not cross `/`, so this
# covers only top-level markdown; markdown in subdirectories still deploys.
*.md

# Suede project files ([S11]). The manifest carries selvage's version and suede
# lineage; `suede task` writes the lockfile and node_modules. None deploy;
# without these lines they would land in ~/. Dot-prefixed source entries (.claude/, .github/) are skipped by
# chezmoi on its own and need no entry here.
package.json
pnpm-lock.yaml
node_modules
node_modules/**

# The Brewfile lists this machine's packages; it is read from the source tree,
# never from ~/. .chezmoiremove can't clean up an old ~/Brewfile: an ignored
# path is never removed.
Brewfile

# Scratch ([S4]). .gitignore and .chezmoiignore are independent: without this,
# tmp/ would deploy to ~/tmp/.
tmp
tmp/**
