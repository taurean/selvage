# ~/.config/ghostty/config
# Selvage-managed. See ~/Developer/selvage/dot_config/ghostty/config.tmpl

# Monaspace Argon for upright and italic. calt is Monaspace's texture healing;
# liga stays off.
font-family = Monaspace Argon
font-family-italic = Monaspace Argon
font-feature = calt
font-feature = -liga
font-size = 14
adjust-cell-height = 20%

window-padding-x = 16
window-padding-y = 12

# Follows macOS appearance. flexoki-light is a local copy of the bundled
# Flexoki Light with whiteBright set to ink, so Claude Code's ANSI theme
# (dark-ansi base, which draws text in whiteBright) reads on both backgrounds.
theme = light:flexoki-light,dark:Flexoki Dark

# New windows start in the repos directory.
working-directory = {{ .chezmoi.homeDir }}/Developer

# transparent keeps a draggable strip tinted to the theme. hidden removes it,
# and every click then starts a selection, leaving no way to move the window.
macos-titlebar-style = transparent

# Wide-gamut color, so theme hex values render as specified on P3 displays.
window-colorspace = display-p3
