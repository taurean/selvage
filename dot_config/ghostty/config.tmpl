# ~/.config/ghostty/config
# Selvage-managed. See ~/Developer/selvage/dot_config/ghostty/config.tmpl

# Monaspace Argon for upright and italic. calt is Monaspace's texture healing;
# liga stays off.
font-family = Monaspace Argon
font-family-italic = Monaspace Argon
font-feature = calt
font-feature = -liga
font-size = 14
adjust-cell-height = 20%

window-padding-x = 16
window-padding-y = 12

# Follows macOS appearance. Both are local themes in themes/, written for the
# P3 colorspace. usgc-highk sets white and whiteBright to the background, so
# Claude Code must not use an ANSI theme; its "auto" theme reads the
# background color and picks its own light or dark palette.
theme = light:usgc-highk,dark:usgc-polyimide
window-colorspace = display-p3

# New windows start in the repos directory.
working-directory = {{ .chezmoi.homeDir }}/Developer

# Transparent keeps the traffic lights and a draggable strip while the title
# bar takes the window background. hidden removes both, leaving no way to move
# the window with the mouse.
macos-titlebar-style = transparent
