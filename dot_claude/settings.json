{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "env": {
    "npm_config_store_dir": "/Users/taurean/Library/pnpm/store"
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "low",
  "promptSuggestionEnabled": false,
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "theme": "custom:flexoki",
  "outputStyle": "Report First",
  "awaySummaryEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "fileCheckpointingEnabled": false,
  "skipAutoPermissionPrompt": true,
  "agentPushNotifEnabled": true,
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog|agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Hero.aiff"
          }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Read(//Users/taurean/.ssh/**)",
      "Read(//Users/taurean/.aws/credentials)",
      "Read(//Users/taurean/.gnupg/**)",
      "Read(//**/*.env)",
      "Read(//**/*.env.*)",
      "Read(//**/.dev.vars)",
      "Read(//Users/**/*.pem)",
      "Read(//Volumes/**/*.pem)",
      "Read(//**/*.key)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(chmod 777:*)",
      "Bash(git reset --hard:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git clean -f:*)"
    ],
    "allow": [
      "WebFetch(domain:lexicon.garden)",
      "Bash(npx tsc:*)"
    ],
    "ask": [
      "Bash(gh issue delete:*)",
      "Bash(gh issue lock:*)",
      "Bash(gh issue transfer:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr lock:*)",
      "Bash(gh release create:*)",
      "Bash(gh release edit:*)",
      "Bash(gh release delete:*)",
      "Bash(gh release upload:*)",
      "Bash(gh workflow run:*)",
      "Bash(gh workflow enable:*)",
      "Bash(gh workflow disable:*)",
      "Bash(gh repo create:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh repo archive:*)",
      "Bash(gh repo fork:*)",
      "Bash(gh secret set:*)",
      "Bash(gh secret delete:*)",
      "Bash(gh api -X:*)",
      "Bash(gh api --method:*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "allowWrite": [
        "~/Library/pnpm/store"
      ],
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.config/stripe",
        "~/.config/sanity",
        "~/.claude/.credentials.json"
      ],
      "allowRead": [
        "~/.ssh/known_hosts",
        "~/.ssh/config",
        "~/.ssh/taurean.pub"
      ]
    },
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "github.com",
        "api.github.com",
        "raw.githubusercontent.com",
        "objects.githubusercontent.com",
        "codeload.github.com",
        "uploads.github.com"
      ],
      "allowLocalBinding": true,
      "allowUnixSockets": [
        "/Users/taurean/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
      ],
      "allowMachLookup": [
        "com.apple.trustd.agent",
        "com.apple.SecurityServer"
      ]
    }
  },
  "enabledPlugins": {
    "commit-commands@claude-plugins-official": false,
    "explanatory-output-style@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": false,
    "learning-output-style@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": false,
    "suede-process@suede-home": true
  },
  "extraKnownMarketplaces": {
    "suede-home": {
      "source": {
        "source": "github",
        "repo": "taurean/suede-home"
      },
      "autoUpdate": true
    }
  },
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Bash(git push origin main:*) — agents push branches and tags but never push directly to main; the human merges",
      "gh commands that create, edit, comment on, close, merge, or delete anything in a repository not owned by taurean — writes to other people's repositories need the human"
    ]
  },
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "voiceEnabled": true
}
